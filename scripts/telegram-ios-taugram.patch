index 0000000000000000000000000000000000000000..a4186c9cc06cc05b88903f555b28530ace5c26d0
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Tau/TauGhostNetwork.swift
@@ -0,0 +1,23 @@
+import Foundation
+import Postbox
+internal import TelegramApi
+import SwiftSignalKit
+import MtProtoKit
+
+struct TauGhostNetwork {
+    let network: Network
+    let blocked: Bool
+
+    func request<T>(_ data: (FunctionDescription, Buffer, DeserializeFunctionResponse<T>)) -> Signal<T, MTRpcError> {
+        if self.blocked {
+            return .fail(MTRpcError(errorCode: 400, errorDescription: "TAUGRAM_GHOST"))
+        }
+        return self.network.request(data)
+    }
+}
+
+extension Network {
+    func tauGhost(_ keyPath: KeyPath<TauGhostFlags, Bool>) -> TauGhostNetwork {
+        return TauGhostNetwork(network: self, blocked: TauCoreSettings.shared.ghost[keyPath: keyPath])
+    }
+}
