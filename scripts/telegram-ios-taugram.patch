--- /dev/null
+++ b/submodules/TelegramCore/Sources/Tau/TauGhostNetwork.swift
@@ -0,0 +1,23 @@
+import Foundation
+import Postbox
+internal import TelegramApi
+import SwiftSignalKit
+import MtProtoKit
+
+struct TauGhostNetwork {
+    let network: Network
+    let blocked: Bool
+
+    func request<T>(_ data: (FunctionDescription, Buffer, DeserializeFunctionResponse<T>)) -> Signal<T, MTRpcError> {
+        if self.blocked {
+            return .fail(MTRpcError(errorCode: 400, errorDescription: "TAUGRAM_GHOST"))
+        }
+        return self.network.request(data)
+    }
+}
+
+extension Network {
+    func tauGhost(_ keyPath: KeyPath<TauGhostFlags, Bool>) -> TauGhostNetwork {
+        return TauGhostNetwork(network: self, blocked: TauCoreSettings.shared.ghost[keyPath: keyPath])
+    }
+}
diff --git a/submodules/TelegramCore/Sources/Tau/TauMessageHistory.swift b/submodules/TelegramCore/Sources/Tau/TauMessageHistory.swift
new file mode 100644
index 0000000000000000000000000000000000000000..8b06ca77bd3f6ca5a954ef4e1ab64aecbcb6a9f6
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Tau/TauMessageHistory.swift
@@ -0,0 +1,223 @@
+import Foundation
+import Postbox
+
+public final class TauDeletedMessageAttribute: MessageAttribute, Equatable {
+    public let date: Int32
+
+    public var associatedPeerIds: [PeerId] {
+        return []
+    }
+
+    public init(date: Int32) {
+        self.date = date
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        self.date = decoder.decodeInt32ForKey("d", orElse: 0)
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeInt32(self.date, forKey: "d")
+    }
+
+    public static func ==(lhs: TauDeletedMessageAttribute, rhs: TauDeletedMessageAttribute) -> Bool {
+        return lhs.date == rhs.date
+    }
+}
+
+public final class TauEditHistoryMessageAttribute: MessageAttribute, Equatable {
+    public struct Version: PostboxCoding, Equatable {
+        public let text: String
+        public let entities: [MessageTextEntity]
+        public let date: Int32
+
+        public init(text: String, entities: [MessageTextEntity], date: Int32) {
+            self.text = text
+            self.entities = entities
+            self.date = date
+        }
+
+        public init(decoder: PostboxDecoder) {
+            self.text = decoder.decodeStringForKey("t", orElse: "")
+            self.entities = decoder.decodeObjectArrayWithDecoderForKey("e")
+            self.date = decoder.decodeInt32ForKey("d", orElse: 0)
+        }
+
+        public func encode(_ encoder: PostboxEncoder) {
+            encoder.encodeString(self.text, forKey: "t")
+            encoder.encodeObjectArray(self.entities, forKey: "e")
+            encoder.encodeInt32(self.date, forKey: "d")
+        }
+    }
+
+    public static let maxVersions = 50
+
+    public let versions: [Version]
+
+    public var associatedPeerIds: [PeerId] {
+        return []
+    }
+
+    public init(versions: [Version]) {
+        self.versions = versions
+    }
+
+    required public init(decoder: PostboxDecoder) {
+        self.versions = decoder.decodeObjectArrayWithDecoderForKey("v")
+    }
+
+    public func encode(_ encoder: PostboxEncoder) {
+        encoder.encodeObjectArray(self.versions, forKey: "v")
+    }
+
+    public static func ==(lhs: TauEditHistoryMessageAttribute, rhs: TauEditHistoryMessageAttribute) -> Bool {
+        return lhs.versions == rhs.versions
+    }
+}
+
+public extension Message {
+    var tauDeletedAttribute: TauDeletedMessageAttribute? {
+        for attribute in self.attributes {
+            if let attribute = attribute as? TauDeletedMessageAttribute {
+                return attribute
+            }
+        }
+        return nil
+    }
+
+    var tauEditHistoryAttribute: TauEditHistoryMessageAttribute? {
+        for attribute in self.attributes {
+            if let attribute = attribute as? TauEditHistoryMessageAttribute {
+                return attribute
+            }
+        }
+        return nil
+    }
+}
+
+func tauMergeMessageAttributes(previous: [MessageAttribute], updated: inout [MessageAttribute]) {
+    for attribute in previous {
+        if attribute is TauEditHistoryMessageAttribute {
+            if !updated.contains(where: { $0 is TauEditHistoryMessageAttribute }) {
+                updated.append(attribute)
+            }
+            return
+        }
+    }
+}
+
+private func tauCanKeepDeletedMessage(_ message: Message) -> Bool {
+    guard message.id.namespace == Namespaces.Message.Cloud else {
+        return false
+    }
+    switch message.id.peerId.namespace {
+    case Namespaces.Peer.CloudUser, Namespaces.Peer.CloudGroup, Namespaces.Peer.CloudChannel:
+        break
+    default:
+        return false
+    }
+    for media in message.media {
+        if media is TelegramMediaAction {
+            return false
+        }
+    }
+    return true
+}
+
+private func tauMarkDeleted(transaction: Transaction, message: Message, date: Int32) {
+    if message.tauDeletedAttribute != nil {
+        return
+    }
+    transaction.updateMessage(message.id, update: { currentMessage in
+        var attributes = currentMessage.attributes
+        attributes.append(TauDeletedMessageAttribute(date: date))
+        return .update(StoreMessage(updating: currentMessage, attributes: attributes, tags: currentMessage.tags))
+    })
+}
+
+func tauKeepDeletedMessages(transaction: Transaction, ids: [MessageId]) -> [MessageId] {
+    guard TauCoreSettings.shared.keepsDeletedMessages else {
+        return ids
+    }
+    let date = Int32(Date().timeIntervalSince1970)
+    var remaining: [MessageId] = []
+    for id in ids {
+        if let message = transaction.getMessage(id), tauCanKeepDeletedMessage(message) {
+            tauMarkDeleted(transaction: transaction, message: message, date: date)
+        } else {
+            remaining.append(id)
+        }
+    }
+    return remaining
+}
+
+func tauKeepDeletedMessages(transaction: Transaction, globalIds: [Int32]) -> [Int32] {
+    guard TauCoreSettings.shared.keepsDeletedMessages else {
+        return globalIds
+    }
+    let date = Int32(Date().timeIntervalSince1970)
+    var remaining: [Int32] = []
+    for globalId in globalIds {
+        if let id = transaction.messageIdsForGlobalIds([globalId]).first, let message = transaction.getMessage(id), tauCanKeepDeletedMessage(message) {
+            tauMarkDeleted(transaction: transaction, message: message, date: date)
+        } else {
+            remaining.append(globalId)
+        }
+    }
+    return remaining
+}
+
+func tauKeepsDeletedMessagesInRange(transaction: Transaction, peerId: PeerId, namespace: MessageId.Namespace, maxId: MessageId.Id) -> Bool {
+    guard TauCoreSettings.shared.keepsDeletedMessages, namespace == Namespaces.Message.Cloud else {
+        return false
+    }
+    var ids: [MessageId] = []
+    transaction.withAllMessages(peerId: peerId, namespace: namespace, { message in
+        if message.id.id <= maxId {
+            ids.append(message.id)
+        }
+        return true
+    })
+    let remaining = tauKeepDeletedMessages(transaction: transaction, ids: ids)
+    if !remaining.isEmpty {
+        transaction.deleteMessages(remaining, forEachMedia: nil)
+    }
+    return true
+}
+
+func tauKeepsMessageAgainstValidation(transaction: Transaction, id: MessageId) -> Bool {
+    guard TauCoreSettings.shared.keepsDeletedMessages else {
+        return false
+    }
+    return tauKeepDeletedMessages(transaction: transaction, ids: [id]).isEmpty
+}
+
+func tauEditHistoryAttribute(previous: Message, updated: StoreMessage) -> TauEditHistoryMessageAttribute? {
+    guard TauCoreSettings.shared.keepsEditHistory else {
+        return nil
+    }
+    let previousEntities = previous.textEntitiesAttribute?.entities ?? []
+    var updatedEntities: [MessageTextEntity] = []
+    for attribute in updated.attributes {
+        if let attribute = attribute as? TextEntitiesMessageAttribute {
+            updatedEntities = attribute.entities
+            break
+        }
+    }
+    if previous.text == updated.text && previousEntities == updatedEntities {
+        return nil
+    }
+    var date = previous.timestamp
+    for attribute in previous.attributes {
+        if let attribute = attribute as? EditedMessageAttribute {
+            date = attribute.date
+            break
+        }
+    }
+    var versions = previous.tauEditHistoryAttribute?.versions ?? []
+    versions.append(TauEditHistoryMessageAttribute.Version(text: previous.text, entities: previousEntities, date: date))
+    if versions.count > TauEditHistoryMessageAttribute.maxVersions {
+        versions.removeFirst(versions.count - TauEditHistoryMessageAttribute.maxVersions)
+    }
+    return TauEditHistoryMessageAttribute(versions: versions)
+}
